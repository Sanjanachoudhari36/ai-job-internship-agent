# AI Job & Internship Automation Platform Configuration

# Secret Key for JWT Authentication
SECRET_KEY=super-secret-career-agent-jwt-key-change-in-production-123456789

# Database URL (SQLite default for zero-friction setup, PostgreSQL supported)
DATABASE_URL=sqlite:///./career_platform.db
# PostgreSQL Example:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/career_platform

# Optional AI Provider API Keys
# (The platform contains built-in heuristic intelligence engines, but you can plug in any LLM API below)
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
AI_MODEL=auto
